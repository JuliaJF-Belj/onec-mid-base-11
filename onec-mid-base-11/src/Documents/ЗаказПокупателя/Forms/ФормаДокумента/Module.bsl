
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ Беляева Ю.Ф. ____16.09.2026 добавляю контактное лицо
	ДЗ_ДоработкаФорм.ПриСозданииНаСервере(ЭтотОбъект);
	//--   
	//++ Беляева Ю.Ф. ____17.09.2026		
	// добавляю кнопку и команду пересчета  
	Команда = Команды.Добавить("ДЗ_ПересчитатьТаблицу");
	Команда.Заголовок = "Пересчитать таблицу";
	Команда.Действие = "ДЗКомандаПересчитатьТаблицу";
	
	Кнопка = Элементы.Добавить("ДЗ_ПересчитатьТаблицу", Тип("КнопкаФормы"), Элементы.ГруппаШапкаЛево);
	Кнопка.ИмяКоманды = "ДЗ_ПересчитатьТаблицу";
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	
	Если Элементы.Найти("ДЗ_СогласованнаяСкидка") <> Неопределено Тогда
		Элементы.ДЗ_СогласованнаяСкидка.УстановитьДействие("ПриИзменении", "ДЗ_СогласованнаяСкидкаПриИзменении");
	КонецЕсли;
	//-- 	
КонецПроцедуры

