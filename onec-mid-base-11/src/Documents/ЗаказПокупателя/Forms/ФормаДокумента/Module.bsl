#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	//++ Беляева Ю.Ф. ____22.07.2026 рассчитываю сумму документа с учетом скидки
	ОбщаяСкидка = ТекущиеДанные.Скидка + Объект.ДЗ_СогласованнаяСкидка;
    КоэффициентСкидки = 1 - ОбщаяСкидка / 100;
    
    ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	//--
	
	//РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

//++ Беляева Ю.Ф. ____17.09.2026
&НаКлиенте
Асинх Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда 
		Возврат;     
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	ОтветНаВопрос = Ждать ВопросАсинх("Пересчитать суммы строк с учетом новой скидки?", Режим, 0); 
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда    
		ДЗ_ПересчитатьТаблицыВсе();
	КонецЕсли;  
	 
КонецПроцедуры   
//--

//++ Беляева Ю.Ф. ____17.09.2026
// команду и кнопку создала программно, прямо в коде ПриСозданииНаСервере. 
// поэтому анализатор EDT не может проследить эту связь (так я прочитала)
&НаКлиенте
Процедура ДЗКомандаПересчитатьТаблицу(Команда)  
	
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда 
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ("Нет данных для пересчета");
		Сообщение.Сообщить();
 		Возврат;     
	КонецЕсли;
	
	ДЗ_ПересчитатьТаблицыВсе();	
			
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчитатьТаблицыВсе()
	
	Для каждого Строка Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
	
	Для каждого Строка Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
	    
    РассчитатьСуммуДокумента();  
    	
КонецПроцедуры
//--

